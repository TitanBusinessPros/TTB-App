rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function userEmail() { return request.auth.token.email.lower(); }
    function memberPath(boardId, uid) {
      return /databases/$(database)/documents/boards/$(boardId)/members/$(uid);
    }
    function invitePath(email, boardId) {
      return /databases/$(database)/documents/board_invites/$(email)/boards/$(boardId);
    }
    function localInvitePath(boardId, email) {
      return /databases/$(database)/documents/boards/$(boardId)/invites/$(email);
    }
    function slotPath(boardId, slotId) {
      return /databases/$(database)/documents/boards/$(boardId)/slots/$(slotId);
    }
    function validSlotId(slotId) { return slotId is string && slotId in ['1', '2', '3', '4']; }
    function isMember(boardId) {
      return verifiedUser()
        && exists(memberPath(boardId, request.auth.uid))
        && (request.auth.uid == boardId || exists(invitePath(userEmail(), boardId)));
    }
    function isAdmin(boardId) { return isMember(boardId) && request.auth.uid == boardId; }
    function hasPremium(boardId) {
      let board = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return (board.get('premiumActive', false) == true
        && board.get('premiumUntil', request.time) > request.time)
        || board.get('premiumGrantUntil', request.time) > request.time;
    }
    function isAssignee(boardId, taskId) {
      return exists(/databases/$(database)/documents/boards/$(boardId)/tasks/$(taskId))
        && get(/databases/$(database)/documents/boards/$(boardId)/tasks/$(taskId)).data.assignee == request.auth.uid;
    }
    function validSheetUrl(url) {
      return url is string && url.size() <= 2000
        && (url == '' || url.matches('https://docs[.]google[.]com/spreadsheets/d/.*'));
    }

    match /board_invites/{email}/boards/{boardId} {
      allow get, list: if verifiedUser() && userEmail() == email;
      allow create: if isAdmin(boardId)
        && request.resource.data.keys().hasAll(['boardId', 'ownerEmail', 'slotId', 'addedAt'])
        && request.resource.data.keys().hasOnly(['boardId', 'ownerEmail', 'slotId', 'addedAt'])
        && request.resource.data.boardId == boardId
        && request.resource.data.ownerEmail == userEmail()
        && email == email.lower()
        && validSlotId(request.resource.data.slotId)
        && getAfter(slotPath(boardId, request.resource.data.slotId)).data.email == email
        && request.resource.data.addedAt == request.time;
      allow update: if false;
      allow delete: if isAdmin(boardId)
        && validSlotId(resource.data.slotId)
        && !existsAfter(slotPath(boardId, resource.data.slotId));
    }

    match /boards/{boardId} {
      allow get: if verifiedUser() && (boardId == request.auth.uid || isMember(boardId));
      allow list: if false;
      allow create: if verifiedUser() && boardId == request.auth.uid
        && request.resource.data.keys().hasAll(['ownerUid', 'ownerEmail', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerEmail == userEmail()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;

      match /invites/{email} {
        allow get, list: if isAdmin(boardId);
        allow create: if isAdmin(boardId)
          && request.resource.data.keys().hasAll(['email', 'slotId', 'addedAt'])
          && request.resource.data.keys().hasOnly(['email', 'slotId', 'addedAt'])
          && request.resource.data.email == email
          && email == email.lower()
          && validSlotId(request.resource.data.slotId)
          && getAfter(slotPath(boardId, request.resource.data.slotId)).data.email == email
          && request.resource.data.addedAt == request.time;
        allow update: if false;
        allow delete: if isAdmin(boardId)
          && validSlotId(resource.data.slotId)
          && !existsAfter(slotPath(boardId, resource.data.slotId));
      }

      match /slots/{slotId} {
        allow get, list: if isAdmin(boardId);
        allow create: if isAdmin(boardId)
          && validSlotId(slotId)
          && request.resource.data.keys().hasAll(['email', 'addedAt'])
          && request.resource.data.keys().hasOnly(['email', 'addedAt'])
          && request.resource.data.email is string
          && request.resource.data.email == request.resource.data.email.lower()
          && request.resource.data.email.size() <= 320
          && request.resource.data.addedAt == request.time
          && getAfter(localInvitePath(boardId, request.resource.data.email)).data.slotId == slotId
          && getAfter(invitePath(request.resource.data.email, boardId)).data.slotId == slotId;
        allow update: if false;
        allow delete: if isAdmin(boardId)
          && !existsAfter(localInvitePath(boardId, resource.data.email))
          && !existsAfter(invitePath(resource.data.email, boardId));
      }

      match /members/{uid} {
        allow get: if isMember(boardId)
          || (verifiedUser() && uid == request.auth.uid
            && (boardId == request.auth.uid || exists(invitePath(userEmail(), boardId))));
        allow list: if isMember(boardId);
        allow create: if verifiedUser() && uid == request.auth.uid
          && (boardId == request.auth.uid || exists(invitePath(userEmail(), boardId)))
          && request.resource.data.keys().hasAll(['email', 'name', 'role', 'joined'])
          && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'joined'])
          && request.resource.data.email == userEmail()
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100
          && request.resource.data.role == (boardId == request.auth.uid ? 'admin' : 'member')
          && request.resource.data.joined == request.time;
        allow update: if isMember(boardId) && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 100;
        allow delete: if isAdmin(boardId) && uid != boardId;
      }

      match /tasks/{taskId} {
        allow read: if isMember(boardId);
        allow create: if isMember(boardId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.assignee is string
          && exists(memberPath(boardId, request.resource.data.assignee))
          && (!request.resource.data.keys().hasAny(['salesPitch'])
            || (request.resource.data.salesPitch is string
              && request.resource.data.salesPitch.size() <= 10000))
          && !request.resource.data.keys().hasAny(['sheetUrl'])
          && !request.resource.data.keys().hasAny(['notes']);
        allow update: if isMember(boardId)
          && !request.resource.data.keys().hasAny(['notes'])
          && exists(memberPath(boardId, request.resource.data.assignee))
          && (!request.resource.data.keys().hasAny(['salesPitch'])
            || (request.resource.data.salesPitch is string
              && request.resource.data.salesPitch.size() <= 10000))
          && !request.resource.data.keys().hasAny(['sheetUrl'])
          && (
            isAdmin(boardId) ||
            (resource.data.assignee == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['salesPitch', 'lastUpdated'])) ||
            (resource.data.assignee == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['column', 'lastUpdated'])
              && request.resource.data.column in ['todo', 'progress', 'review', 'done']) ||
            (resource.data.createdBy == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attachments']))
          );
        allow delete: if isAdmin(boardId);

        match /notes/{noteId} {
          allow get, list: if isMember(boardId)
            && (isAdmin(boardId) || isAssignee(boardId, taskId));
          allow create: if isMember(boardId)
            && (isAdmin(boardId) || isAssignee(boardId, taskId))
            && request.resource.data.keys().hasAll(['body', 'authorUid', 'createdAt'])
            && request.resource.data.keys().hasOnly(['body', 'authorUid', 'createdAt'])
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 5000
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow delete: if isMember(boardId)
            && (isAdmin(boardId) || isAssignee(boardId, taskId));
          allow update: if false;
        }
        match /premium/{premiumId} {
          allow get: if premiumId == 'sheet' && isMember(boardId) && hasPremium(boardId);
          allow list: if false;
          allow create, update: if premiumId == 'sheet' && isMember(boardId) && hasPremium(boardId)
            && (isAdmin(boardId) || isAssignee(boardId, taskId))
            && request.resource.data.keys().hasOnly(['url'])
            && request.resource.data.keys().hasAll(['url'])
            && validSheetUrl(request.resource.data.url)
            && request.resource.data.url != '';
          allow delete: if premiumId == 'sheet' && isMember(boardId) && hasPremium(boardId)
            && (isAdmin(boardId) || isAssignee(boardId, taskId));
        }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
