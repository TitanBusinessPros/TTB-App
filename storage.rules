rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function isMember(boardId) {
      return verifiedUser()
        && (request.auth.uid == boardId
          ? true
          : firestore.exists(/databases/(default)/documents/board_invites/$(request.auth.token.email.lower())/boards/$(boardId)));
    }
    function hasPremium(boardId) {
      return firestore.get(/databases/(default)/documents/boards/$(boardId)).data.premiumActive == true
        && firestore.get(/databases/(default)/documents/boards/$(boardId)).data.premiumUntil > request.time;
    }

    match /boards/{boardId}/attachments/{taskId}/{fileName} {
      allow read: if isMember(boardId) && hasPremium(boardId);
      allow create: if isMember(boardId) && hasPremium(boardId)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.metadata.uploaderUid == request.auth.uid;
      allow delete: if isMember(boardId)
        && (request.auth.uid == boardId || resource.metadata.uploaderUid == request.auth.uid);
      allow update: if false;
    }
  }
}
