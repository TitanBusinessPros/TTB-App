rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function verifiedUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }
    function isMember(boardId) {
      return verifiedUser()
        && (request.auth.uid == boardId
          ? true
          : firestore.exists(/databases/(default)/documents/board_invites/$(request.auth.token.email.lower())/boards/$(boardId)));
    }
    function canManageFile(boardId, taskId) {
      return request.auth.uid == boardId
        || firestore.get(/databases/(default)/documents/boards/$(boardId)/tasks/$(taskId)).data.createdBy == request.auth.uid
        || firestore.get(/databases/(default)/documents/boards/$(boardId)/tasks/$(taskId)).data.assignee == request.auth.uid;
    }

    match /boards/{boardId}/attachments/{taskId}/{fileName} {
      allow read: if isMember(boardId);
      allow create: if isMember(boardId)
        && request.resource.size <= 20 * 1024 * 1024
        && canManageFile(boardId, taskId);
      allow delete: if isMember(boardId) && canManageFile(boardId, taskId);
      allow update: if false;
    }
  }
}
